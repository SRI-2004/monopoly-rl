{
    "global": {
      "optimizer": "AdamW",
      "lr": "linear:0.0005->0.00001",
      "num_players": 4,
      "max_steps": 2000,
      "total_timesteps": 25000000,
      "cuda": true,
      "gamma": 0.997,
      "gae_lambda": 0.95,
      "clip_coef": 0.15,
      "update_epochs": 8,
      "entropy_coef": 0.01,
      "vf_coef": 0.5,
      "num_envs": 24,
      "num_steps": 512,
      "minibatch_size": 4096,
      "seed": 42,
      "hidden_dim": 128,
      "hidden_layers": 2,
      "activation": "tanh",
      "orthogonal_init": true,
      "layer_norm": true,
      "norm_adv": true,
      "clip_vloss": true,
      "max_grad_norm": 0.5,
      "curriculum_steps": 5000000,
      "self_play_steps": 15000000,
      "population_steps": 5000000,
      "checkpoint_freq": 200,
      "eval_freq": 500,
      "save_path": "rl_agent/checkpoints/enhanced_training"
    },
    "curriculum_phase": {
      "comment": "Phase 1: Learn against scripted opponents with simplified game mechanics",
      "max_steps": 1000,
      "num_envs": 16,
      "learning_rate_multiplier": 1.5,
      "entropy_bonus": 0.02,
      "exploration_bonus": 0.1,
      "property_purchase_reward": 0.1,
      "monopoly_formation_reward": 1.0
    },
    "self_play_phase": {
      "comment": "Phase 2: Self-play with gradually increasing complexity",
      "max_steps": 2000,
      "num_envs": 32,
      "opponent_sampling": {
        "current_policy": 0.4,
        "recent_checkpoints": 0.4,
        "random_historical": 0.2
      },
      "checkpoint_pool_size": 20,
      "diversity_bonus": 0.05
    },
    "population_phase": {
      "comment": "Phase 3: Population-based training with diverse strategies",
      "max_steps": 3000,
      "num_envs": 48,
      "population_size": 8,
      "mutation_rate": 0.1,
      "crossover_rate": 0.3,
      "selection_pressure": 0.2,
      "diversity_threshold": 0.8
    },
    "per_agent": {
      "player_0": {
        "comment": "Aggressive property buyer",
        "optimizer": "AdamW",
        "lr": "linear:5e-4->1e-5",
        "entropy_schedule": "linear:0.025->0.005",
        "clip_schedule": "cosine:0.3->0.1",
        "strategy_bias": {
          "property_purchase": 1.3,
          "monopoly_focus": 1.2,
          "trading_aggression": 1.1
        }
      },
      "player_1": {
        "comment": "Conservative cash manager",
        "optimizer": "RMSprop",
        "lr": "piecewise:3e-4->1e-4@8000000",
        "rmsprop_alpha": 0.95,
        "entropy_schedule": "fixed:0.008",
        "clip_schedule": "linear:0.2->0.1",
        "strategy_bias": {
          "cash_management": 1.4,
          "risk_aversion": 1.3,
          "late_game_focus": 1.2
        }
      },
      "player_2": {
        "comment": "Balanced strategic player",
        "optimizer": "Adam",
        "lr": "cosine:2e-4->5e-6",
        "entropy_schedule": "linear:0.015->0.003",
        "gamma": 0.999,
        "gae_lambda": 0.98,
        "strategy_bias": {
          "balanced_approach": 1.0,
          "adaptive_strategy": 1.2
        }
      },
      "player_3": {
        "comment": "High-risk high-reward player",
        "optimizer": "AdamW",
        "lr": "piecewise:6e-4->2e-4@10000000",
        "clip_schedule": "piecewise:0.25->0.15@12000000",
        "update_epochs": 6,
        "entropy_schedule": "linear:0.03->0.008",
        "strategy_bias": {
          "risk_taking": 1.5,
          "aggressive_building": 1.4,
          "trading_frequency": 1.3
        }
      }
    },
    "population_variants": {
      "variant_1": {
        "comment": "Ultra-aggressive early game",
        "early_game_aggression": 2.0,
        "property_purchase_threshold": 0.3
      },
      "variant_2": {
        "comment": "Late-game specialist",
        "late_game_focus": 1.8,
        "monopoly_completion_bonus": 1.5
      },
      "variant_3": {
        "comment": "Trading specialist",
        "trading_frequency": 2.0,
        "negotiation_skill": 1.6
      },
      "variant_4": {
        "comment": "Defensive player",
        "cash_hoarding": 1.7,
        "risk_aversion": 1.9
      }
    }
} 